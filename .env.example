# API Province Sud
PROVINCE_SUD_API_KEY=

# Moteur : postgresql ou sqlserver
DB_ENGINE=postgresql

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=peche_nc
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# SQL Server avec authentification Windows. Adapter le nom de l'instance.
SQLSERVER_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=peche_nc;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes

# HTTP (secondes)
HTTP_TIMEOUT=30
